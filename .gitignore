# 依赖（不入库，部署时平台自动 npm install）
backend/node_modules/

# 运行时数据（不入库；部署时由挂载卷 /data 持久化，详见 DEPLOY.md）
backend/data/

# 本地密钥（含数据库连接的 .env，切勿入库）
.env
backend/.env
*.env.example
backend/.env*

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log

# WorkBuddy 本地数据
.workbuddy/

# 微信开发者工具私密配置（含本机 AppID，按惯例不入库）
project.private.config.json
**/project.private.config.json
