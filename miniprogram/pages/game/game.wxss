.page.game {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0f5 0%, #fdeef6 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.g-head { margin-bottom: 30rpx; }
.g-title { font-size: 44rpx; font-weight: 700; color: #d6336c; }
.g-sub { font-size: 26rpx; color: #b0849c; margin-top: 8rpx; }

.status {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(255,107,157,0.12);
  margin-bottom: 40rpx;
  min-height: 120rpx;
}
.status-text { font-size: 34rpx; font-weight: 700; color: #5b3a4b; }
.result { font-size: 44rpx; font-weight: 800; margin-top: 16rpx; }
.result.win { color: #4caf6e; }
.result.lose { color: #e84393; }
.result.tie { color: #5b8def; }
.vs { font-size: 26rpx; color: #b07a93; margin-top: 14rpx; }
.status.waiting .status-text { color: #e84393; }

.hands { display: flex; justify-content: space-around; gap: 20rpx; }
.hand {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(255,107,157,0.1);
  border: 4rpx solid transparent;
}
.hand.picked { border-color: #e84393; background: #fff0f6; transform: scale(1.04); }
.h-emoji { font-size: 90rpx; line-height: 1; }
.h-label { font-size: 26rpx; color: #b07a93; margin-top: 14rpx; }

.again {
  margin: 40rpx auto 0;
  width: 320rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff9ec4, #e84393);
  color: #fff; font-size: 30rpx; font-weight: 700;
  padding: 24rpx 0; border-radius: 50rpx;
  box-shadow: 0 12rpx 30rpx rgba(232,67,147,0.35);
}

.g-tip { margin-top: 40rpx; text-align: center; font-size: 23rpx; color: #b0849c; line-height: 1.6; }
