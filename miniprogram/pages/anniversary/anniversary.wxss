.page.anni {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0f5 0%, #fdeef6 100%);
  padding: 40rpx 32rpx 160rpx;
  box-sizing: border-box;
}
.a-head { margin-bottom: 24rpx; }
.a-title { font-size: 44rpx; font-weight: 700; color: #d6336c; }
.a-sub { font-size: 26rpx; color: #b0849c; margin-top: 8rpx; }

.love-box {
  background: linear-gradient(135deg, #ff9ec4, #e84393);
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(232,67,147,0.3);
}
.lb-num { font-size: 80rpx; font-weight: 800; line-height: 1; }
.lb-lab { font-size: 26rpx; margin-top: 12rpx; opacity: 0.92; }

.a-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(255,107,157,0.1);
}
.a-name { font-size: 32rpx; font-weight: 600; color: #5b3a4b; }
.a-date { font-size: 24rpx; color: #b07a93; margin-top: 8rpx; }
.a-right { text-align: right; }
.a-cd { font-size: 30rpx; font-weight: 700; color: #e84393; }
.a-del { font-size: 22rpx; color: #c9a9b8; margin-top: 10rpx; }

.empty { text-align: center; color: #b0849c; font-size: 26rpx; padding: 60rpx 0; }

.fab {
  position: fixed;
  left: 50%;
  bottom: 48rpx;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #ff9ec4, #e84393);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 56rpx;
  border-radius: 50rpx;
  box-shadow: 0 12rpx 30rpx rgba(232,67,147,0.4);
}

.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: flex-end;
  z-index: 50;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx 60rpx;
  box-sizing: border-box;
}
.s-title { font-size: 34rpx; font-weight: 700; color: #5b3a4b; text-align: center; margin-bottom: 28rpx; }
.s-input {
  background: #f6f0f4;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.s-picker {
  background: #f6f0f4;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #5b3a4b;
  margin-bottom: 20rpx;
}
.s-btns { display: flex; gap: 20rpx; margin-top: 10rpx; }
.s-cancel, .s-ok {
  flex: 1; text-align: center; padding: 24rpx 0; border-radius: 16rpx; font-size: 30rpx; font-weight: 700;
}
.s-cancel { background: #f3e7ee; color: #b07a93; }
.s-ok { background: linear-gradient(135deg, #ff9ec4, #e84393); color: #fff; }
