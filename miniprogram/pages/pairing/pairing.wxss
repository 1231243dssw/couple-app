.field-label { font-size: 28rpx; color: #b07a93; margin-bottom: 14rpx; }
.input {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  font-size: 32rpx;
  border: 2rpx solid #ffd0e2;
}
.big-emoji { font-size: 80rpx; text-align: center; margin-bottom: 10rpx; }
.card-title { font-size: 36rpx; font-weight: 700; color: #5b3a4b; text-align: center; }
.card-desc { font-size: 26rpx; color: #b07a93; text-align: center; margin-top: 14rpx; line-height: 1.5; }
.code-card { text-align: center; }
.code {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: #e84393;
  margin: 20rpx 0 6rpx;
  font-family: "Courier New", monospace;
}
.code-input { text-align: center; letter-spacing: 12rpx; font-size: 48rpx; font-weight: 700; }
.waiting { margin-top: 28rpx; font-size: 26rpx; color: #b07a93; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.dot {
  width: 16rpx; height: 16rpx; border-radius: 50%; background: #ff6b9d;
  animation: pulse 1.2s ease-in-out infinite;
}
.bound-tip { margin-top: 28rpx; font-size: 28rpx; color: #e84393; font-weight: 700; }
.switch { text-align: center; margin-top: 20rpx; font-size: 26rpx; color: #e84393; text-decoration: underline; }
