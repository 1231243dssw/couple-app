.card-desc { font-size: 24rpx; color: #b07a93; margin-top: 8rpx; line-height: 1.5; margin-bottom: 16rpx; }
.card-title { font-size: 32rpx; font-weight: 700; color: #5b3a4b; }

.sched { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 2rpx solid #ffe3ef; }
.sched-main { flex: 1; }
.sched-time { font-size: 28rpx; font-weight: 700; color: #e84393; }
.sched-text { font-size: 28rpx; color: #6b4a5b; margin-top: 6rpx; }
.sched-ops { display: flex; align-items: center; gap: 18rpx; }
.del { font-size: 26rpx; color: #c98ba6; }
.empty { font-size: 26rpx; color: #c9a8b8; text-align: center; padding: 20rpx 0; }

.add { margin-top: 24rpx; }
.input { background: #fff; border-radius: 18rpx; padding: 22rpx 24rpx; font-size: 30rpx; border: 2rpx solid #ffd0e2; }
.add-row { display: flex; gap: 18rpx; margin-top: 18rpx; align-items: center; }
.time-pick { flex: 0 0 auto; }
.time-box { background: #fff; border: 2rpx solid #ffd0e2; border-radius: 18rpx; padding: 20rpx 26rpx; font-size: 28rpx; color: #e84393; }
.add-btn { flex: 1; margin: 0; padding: 20rpx 0; font-size: 30rpx; }

.quote { font-size: 30rpx; line-height: 1.6; color: #5b3a4b; padding: 18rpx 0; border-bottom: 2rpx solid #ffe3ef; font-style: italic; }
.copy { font-size: 22rpx; color: #e84393; font-style: normal; margin-left: 8rpx; }
