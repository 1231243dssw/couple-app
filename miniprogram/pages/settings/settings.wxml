<view class="page">
  <view class="title">设置 ⚙️</view>
  <view class="subtitle">绑定信息与服务配置</view>

  <view class="card">
    <view class="row"><text class="k">我的昵称</text><text class="v">{{myName}}</text></view>
    <view class="row"><text class="k">TA 的昵称</text><text class="v">{{partnerName}}</text></view>
    <view class="row"><text class="k">邀请码</text><text class="v code" bindtap="copyCode">{{code}} 📋</text></view>
  </view>

  <view class="card">
    <view class="card-title">服务地址（高级）</view>
    <view class="card-desc">思念需要后端实时服务。默认已指向已上线的公网服务；若你自行部署，可在此修改。</view>
    <view class="field-label">HTTP 地址</view>
    <input class="input" value="{{serverUrl}}" bindinput="onServer" placeholder="https://你的域名" />
    <view class="field-label mt-20">WebSocket 地址</view>
    <input class="input" value="{{wsUrl}}" bindinput="onWs" placeholder="wss://你的域名" />
    <view class="field-label mt-20">访问令牌 (sharecode)</view>
    <input class="input" value="{{shareCode}}" bindinput="onShare" placeholder="发布平台提供的 sharecode" />

    <view class="status mt-20">实时连接：<text class="dot {{connClass}}">{{connStatus}}</text></view>
    <button class="btn btn-ghost mt-20" bindtap="testConn">测试后端连接</button>
    <view wx:if="{{health}}" class="health">{{health}}</view>
    <button class="btn btn-primary mt-20" bindtap="saveServer">保存并应用</button>
    <button class="btn btn-ghost mt-20" bindtap="resetDefault">恢复默认配置</button>
  </view>

  <view class="card danger">
    <view class="card-title">解除绑定</view>
    <view class="card-desc">会清除本机绑定信息（TA 端不受影响，可重新加入）。</view>
    <button class="btn btn-ghost danger-btn" bindtap="unbind">退出并解绑</button>
  </view>

  <view class="about">思念你 · 用每一次想念，靠近彼此 💗</view>
</view>
