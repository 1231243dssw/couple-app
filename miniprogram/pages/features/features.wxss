.page.features {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0f5 0%, #fdeef6 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.f-head { margin-bottom: 32rpx; }
.f-title { font-size: 44rpx; font-weight: 700; color: #d6336c; }
.f-sub { font-size: 26rpx; color: #b0849c; margin-top: 8rpx; }

.f-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.f-card {
  width: 48%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.12);
  box-sizing: border-box;
}
.f-emoji { font-size: 56rpx; }
.f-name { font-size: 30rpx; font-weight: 600; color: #333; margin-top: 16rpx; }
.f-desc { font-size: 23rpx; color: #9b8aa3; margin-top: 8rpx; line-height: 1.4; min-height: 64rpx; }
.f-go { font-size: 24rpx; color: #ff6b9d; margin-top: 16rpx; font-weight: 600; }

.f-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #b0849c;
  text-align: center;
  line-height: 1.6;
}
