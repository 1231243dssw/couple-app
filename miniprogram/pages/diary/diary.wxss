.tabs { display: flex; gap: 18rpx; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 22rpx; background: rgba(255,255,255,0.6); color: #b07a93; font-size: 28rpx; font-weight: 600; }
.tab.on { background: linear-gradient(135deg, #ff6b9d, #e84393); color: #fff; box-shadow: 0 10rpx 24rpx rgba(232,67,147,0.3); }

.empty { text-align: center; color: #c9a8b8; font-size: 26rpx; padding: 50rpx 0; }

.entry { padding: 28rpx 28rpx; }
.e-top { display: flex; justify-content: space-between; align-items: center; }
.e-title { font-size: 32rpx; font-weight: 700; color: #5b3a4b; }
.e-from { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.e-from.me { background: #ffe3ef; color: #e84393; }
.e-from.ta { background: #efe6ff; color: #a18cd1; }
.e-body { font-size: 28rpx; color: #6b4a5b; margin: 14rpx 0; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.e-foot { display: flex; justify-content: space-between; align-items: center; }
.e-time { font-size: 22rpx; color: #c9a8b8; }
.e-unread { font-size: 22rpx; color: #e84393; font-weight: 700; }

.fab {
  position: fixed; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #ff6b9d, #e84393); color: #fff;
  border-radius: 999rpx; padding: 24rpx 40rpx; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(232,67,147,0.4); z-index: 50;
}
.fab:active { transform: scale(0.96); }

.mask { position: fixed; inset: 0; background: rgba(107,74,91,0.45); display: flex; align-items: flex-end; z-index: 100; }
.sheet { width: 100%; background: #fff; border-radius: 36rpx 36rpx 0 0; padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 36rpx; font-weight: 700; color: #5b3a4b; margin-bottom: 24rpx; }
.input { background: #fff5fa; border-radius: 18rpx; padding: 22rpx 24rpx; font-size: 30rpx; border: 2rpx solid #ffd0e2; margin-bottom: 18rpx; }
.ta { width: 100%; box-sizing: border-box; height: 240rpx; background: #fff5fa; border-radius: 18rpx; padding: 22rpx 24rpx; font-size: 30rpx; border: 2rpx solid #ffd0e2; }
.sheet-ops { display: flex; gap: 18rpx; margin-top: 24rpx; }
.sheet-ops .btn { flex: 1; }
